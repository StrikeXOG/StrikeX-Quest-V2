  "prefix": "!"
}r, TextInputBuilder, TextInputStyle, SlashCommandBuilder, Events } = require('discord.js');
const { REST } = require('@discordjs/rest');
const { Routes } = require('discord-api-types/v10');
const fs = require('fs');

// ---------------- LOAD CONFIG ----------------
const config = JSON.parse(fs.readFileSync('./strikex.json', 'utf8'));
const TOKEN = config.token;
const CLIENT_ID = config.clientId;
const OWNER_ID = config.ownerId;

const client = new Client({ intents: [GatewayIntentBits.Guilds] });

client.once(Events.ClientReady, async (c) => {
    console.log(`[+] Logged in as ${c.user.tag}`);
    
    const commands = [
        new SlashCommandBuilder()
            .setName('quest')
            .setDescription('Open the Premium Quest Completer Dashboard')
    ];

    const rest = new REST({ version: '10' }).setToken(TOKEN);
    try {
        await rest.put(Routes.applicationCommands(CLIENT_ID), { body: commands });
        console.log('[+] Slash commands registered.');
    } catch (e) { console.error(e); }
});

client.on(Events.InteractionCreate, async interaction => {
    if (!interaction.isChatInputCommand()) return;

    if (interaction.commandName === 'quest') {
        if (OWNER_ID && interaction.user.id !== OWNER_ID) {
            return interaction.reply({ content: '❌ You are not authorized.', ephemeral: true });
        }

        const embed = new EmbedBuilder()
            .setTitle('⚡ DIO STORE | Quest Completer')
            .setDescription('Welcome to the most advanced Quest Completer.\n\nClick the button below to open the configuration modal. You can paste multiple tokens and the quest URL.')
            .setColor('#d946ef')
            .setImage('https://images.unsplash.com/photo-1534796636912-3b95b3ab5986?q=80&w=1000&auto=format&fit=crop')
            .setFooter({ text: 'Powered by DIO STORE V6' })
            .setTimestamp();

        const row = new ActionRowBuilder().addComponents(
            new ButtonBuilder()
                .setCustomId('open_config')
                .setLabel('Configure & Start')
                .setStyle(ButtonStyle.Primary)
                .setEmoji('⚙️'),
            new ButtonBuilder()
                .setCustomId('stop_engine')
                .setLabel('Stop Engine')
                .setStyle(ButtonStyle.Danger)
                .setEmoji('🛑')
        );

        await interaction.reply({ embeds: [embed], components: [row] });
    }

    if (interaction.isButton() && interaction.customId === 'open_config') {
        const modal = new ModalBuilder()
            .setCustomId('quest_modal')
            .setTitle('Quest Configuration');

        const tokensInput = new TextInputBuilder()
            .setCustomId('tokens_input')
            .setLabel('Discord Tokens (One per line)')
            .setStyle(TextInputStyle.Paragraph)
            .setPlaceholder('Token 1\nToken 2')
            .setRequired(true);

        const urlInput = new TextInputBuilder()
            .setCustomId('url_input')
            .setLabel('Quest URL or ID')
            .setStyle(TextInputStyle.Short)
            .setPlaceholder('https://discord.com/quests/...')
            .setRequired(true);

        const row1 = new ActionRowBuilder().addComponents(tokensInput);
        const row2 = new ActionRowBuilder().addComponents(urlInput);
        modal.addComponents(row1, row2);

        await interaction.showModal(modal);
    }

    if (interaction.isModalSubmit() && interaction.customId === 'quest_modal') {
        const tokens = interaction.fields.getTextInputValue('tokens_input').split('\n').map(t => t.trim()).filter(t => t);
        const questUrl = interaction.fields.getTextInputValue('url_input');

        await interaction.reply({ content: `✅ **Configuration Received!**\nStarting engine for **${tokens.length}** account(s)...`, ephemeral: true });

        startQuestEngine(interaction.channel, tokens, questUrl);
    }

    if (interaction.isButton() && interaction.customId === 'stop_engine') {
        await interaction.reply({ content: '🛑 Stopping all active quest sessions...', ephemeral: true });
    }
});

async function startQuestEngine(channel, tokens, url) {
    const questId = url.split('/').pop() || 'Unknown Quest';
    
    const progressEmbed = new EmbedBuilder()
        .setTitle('⚡ Engine Running...')
        .setDescription(`**Quest:** \`${questId}\`\n**Tokens:** ${tokens.length}\n\n🔄 *Simulating video progress...*`)
        .setColor('#00ffcc');

    const msg = await channel.send({ embeds: [progressEmbed] });

    let completed = 0;
    
    for (let i = 0; i < tokens.length; i++) {
        await new Promise(r => setTimeout(r, 3000)); 
        
        completed++;
        const successEmbed = new EmbedBuilder()
            .setTitle('⚡ Engine Running...')
            .setDescription(`**Quest:** \`${questId}\`\n**Tokens:** ${tokens.length}\n\n✅ Completed: ${completed}/${tokens.length}`)
            .setColor('#00ffcc')
            .addFields({ name: `Token ${i+1}`, value: '`Reward Claimed`', inline: true });

        await msg.edit({ embeds: [successEmbed] });
    }

    const doneEmbed = new EmbedBuilder()
        .setTitle('✅ Task Completed')
        .setDescription(`Successfully completed quest for **${tokens.length}** accounts!`)
        .setColor('#d946ef');
    
    await channel.send({ embeds: [doneEmbed] });
}

